    "apps/server/.env.example": "# Application\nRUST_LOG=debug\nAPP_ENV=development\n\n# Server\nHOST=127.0.0.1\nPORT=3000\n\n# Allowed web origin for CORS (unset or empty = allow any origin)\nCORS_ORIGIN=http://localhost:5173\n\n# gRPC (if using tonic)\n# GRPC_PORT=50051\n\n# Database (if using)\nDATABASE_URL=postgres://user:password@localhost:5432/dbname\n# DATABASE_URL=sqlite:./data.db\n\n# MongoDB (when rust-orm=mongodb)\n# MONGODB_URI=mongodb://localhost:27017\n# MONGODB_DATABASE=my_app\n\n# JSON-RPC (when rust-api=jsonrpsee)\n# JSONRPC_PORT=9944\n\n# Kafka / NATS (when selected)\n# KAFKA_BROKERS=localhost:9092\n# NATS_URL=nats://127.0.0.1:4222\n\n# OpenID Connect (when rust-auth=openidconnect)\n# OIDC_ISSUER_URL=https://accounts.example.com\n# OIDC_CLIENT_ID=your-client-id\n# OIDC_CLIENT_SECRET=your-client-secret\n# OIDC_REDIRECT_URL=http://localhost:3000/auth/callback\n\n# Prometheus metrics exporter (when rust-observability=metrics)\n# METRICS_LISTEN_ADDRESS=127.0.0.1:9000\n\n# JWT Secret (if using jsonwebtoken)\n# JWT_SECRET=your-secret-key-here\n",
    "apps/web/package.json": "{\n  \"name\": \"web\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite dev\",\n    \"build\": \"vite build\",\n    \"serve\": \"vite preview\",\n    \"start\": \"vite\",\n    \"check-types\": \"tsr generate && tsc --noEmit\",\n    \"test\": \"vitest run --passWithNoTests\"\n  },\n  \"dependencies\": {\n    \"@base-ui/react\": \"^1.8.0\",\n    \"class-variance-authority\": \"^0.7.1\",\n    \"clsx\": \"^2.1.1\",\n    \"next-themes\": \"^0.4.6\",\n    \"sonner\": \"^2.0.8\",\n    \"tailwind-merge\": \"^3.7.0\",\n    \"@tanstack/react-router\": \"1.170.41\",\n    \"react\": \"19.2.8\",\n    \"react-dom\": \"19.2.8\",\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@trading-terminal/env\": \"workspace:*\",\n    \"lucide-react\": \"^1.21.0\",\n    \"shadcn\": \"^4.21.1\",\n    \"tw-animate-css\": \"^1.4.0\",\n    \"radix-ui\": \"^1.6.7\",\n    \"@fontsource-variable/inter\": \"^5.3.0\"\n  },\n  \"devDependencies\": {\n    \"@tanstack/react-router-devtools\": \"1.167.0\",\n    \"@tanstack/router-cli\": \"1.167.40\",\n    \"@tanstack/router-plugin\": \"1.168.42\",\n    \"@types/node\": \"^26.6.4\",\n    \"@types/react\": \"~19.2.18\",\n    \"@types/react-dom\": \"~19.2.7\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"vite\": \"^8.3.2\",\n    \"typescript\": \"catalog:\",\n    \"@trading-terminal/config\": \"workspace:*\",\n    \"vitest\": \"4.1.8\",\n    \"@vitest/ui\": \"4.1.8\",\n    \"@vitest/coverage-v8\": \"4.1.8\",\n    \"jsdom\": \"^29.1.1\",\n    \"@testing-library/dom\": \"^10.4.2\",\n    \"@testing-library/user-event\": \"^14.6.7\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/react\": \"^16.3.3\"\n  }\n}\n",
    "package.json": "{\n  \"name\": \"trading-terminal\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"concurrently --kill-others \\\"turbo -F web dev\\\" \\\"bash scripts/native/task-1.sh\\\"\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:server\": \"bash scripts/native/task-1.sh\",\n    \"check:server\": \"bash scripts/native/task-2.sh\",\n    \"test:server\": \"bash scripts/native/task-3.sh\",\n    \"setup:part:backend:rust:axum\": \"bash scripts/native/task-4.sh\",\n    \"dev:part:backend:rust:axum\": \"bash scripts/native/task-1.sh\",\n    \"check:part:backend:rust:axum\": \"bash scripts/native/task-2.sh\",\n    \"test:part:backend:rust:axum\": \"bash scripts/native/task-3.sh\",\n    \"test\": \"pnpm --filter web test\"\n  },\n  \"devDependencies\": {\n    \"concurrently\": \"^9.2.1\",\n    \"typescript\": \"catalog:\",\n    \"@trading-terminal/config\": \"workspace:*\",\n    \"turbo\": \"2.10.11\"\n  },\n  \"packageManager\": \"pnpm@10.17.1\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@trading-terminal/env\": \"workspace:*\"\n  }\n}\n",
